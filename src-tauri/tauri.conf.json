{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aoe4-almanac",
  "version": "0.1.0",
  "identifier": "com.torryt.aoe4-almanac",
  "build": {
    "beforeDevCommand": "pnpm --filter @aoe4-almanac/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @aoe4-almanac/web build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "aoe4-almanac",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
