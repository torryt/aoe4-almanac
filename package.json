{
  "name": "aoe4-almanac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "build": "pnpm --filter \"./packages/*\" run build && pnpm --filter \"./apps/*\" run build",
    "start": "pnpm --filter ./apps/server run start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "db:generate": "pnpm --filter ./apps/server run db:generate",
    "db:migrate": "pnpm --filter ./apps/server run db:migrate",
    "db:seed": "pnpm --filter ./apps/server run db:seed",
    "db:audit-civ-slugs": "pnpm --filter ./apps/server run db:audit-civ-slugs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "oxlint": "^1.66.0",
    "oxfmt": "^0.51.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
